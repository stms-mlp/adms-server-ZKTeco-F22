# Servidor ADMS ZKTeco - reescritura para hosting compartido (Apache)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o carpeta existe, servirlo tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás va al front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Proteger archivos sensibles de acceso directo por la web.
<FilesMatch "\.(sql|md|json|example\.php)$">
    Require all denied
</FilesMatch>

<Files config.php>
    Require all denied
</Files>

# Bloquear el acceso directo a la carpeta de código fuente.
RedirectMatch 403 ^/src/.*$
RedirectMatch 403 ^/database/.*$
