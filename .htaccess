# Servidor ADMS ZKTeco - reescritura para hosting compartido (Apache)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o carpeta existe, servirlo tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás va al front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Proteger archivos sensibles de acceso directo por la web.
<FilesMatch "\.(sql|md|json|example\.php|sqlite|sqlite3|db|db-wal|db-shm|sqlite-wal|sqlite-shm)$">
    Require all denied
</FilesMatch>

<Files config.php>
    Require all denied
</Files>

# Bloquear el acceso directo a carpetas internas (código y base de datos).
RedirectMatch 403 ^.*/src/.*$
RedirectMatch 403 ^.*/database/.*$
RedirectMatch 403 ^.*/data/.*$
